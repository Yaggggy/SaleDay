ENVIRONMENT=development
DEBUG=true

DATABASE_URL=mysql+pymysql://saleday:saleday@mysql:3306/saleday?charset=utf8mb4

SECRET_KEY=replace-this-with-a-long-random-string-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

COOKIE_SECURE=false
FRONTEND_URL=http://localhost:5173
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
PUBLIC_APP_URL=http://localhost:5173

UPLOAD_DIR=/app/uploads
MAX_UPLOAD_SIZE_MB=8

# Outbound email for team invitations. Leave SMTP_HOST blank to disable
# sending (invitation links will just be logged server-side instead).
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_USE_TLS=true
SMTP_FROM_EMAIL=no-reply@saleday.app
SMTP_FROM_NAME=SaleDay

BULK_IMPORT_MAX_ROWS=500
BULK_IMPORT_MAX_FILE_MB=5
